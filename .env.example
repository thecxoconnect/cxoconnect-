# ==============================================================================
# CXO Connect - Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/cxoconnect

# Security & Authentication
JWT_SECRET=cxo_connect_super_secret_jwt_key_2026_production_grade
SUPER_ADMIN_EMAILS=admin@cxoconnect.com,theanvisharma@gmail.com

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email / Nodemailer Service Configuration
EMAIL_USER=notifications@cxoconnect.com
EMAIL_PASS=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
FROM_EMAIL="CXO Connect" <notifications@cxoconnect.com>

# ImageKit Media Optimization & CDN Service
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/cxoconnect
